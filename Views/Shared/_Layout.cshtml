<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Study Planner</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>
    <header class="topbar">
        <div class="container-fluid px-4 d-flex align-items-center justify-content-between">
            <a class="brand" asp-controller="Dashboard" asp-action="Index">
                <span class="brand-icon">✓</span>
                <span>Study Planner</span>
            </a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="d-flex align-items-center gap-3">
                    <span class="welcome">Hi, @User.Identity.Name 👋</span>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-sm btn-light">Logout</button>
                    </form>
                </div>
            }
        </div>
    </header>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <nav class="sidebar">
            <a asp-controller="Dashboard" asp-action="Index">🏠 Dashboard</a>
            <a asp-controller="Subjects" asp-action="Index">📚 Subjects</a>
            <a asp-controller="StudyPlan" asp-action="Index">🗓 Study Plan</a>
        </nav>
    }

    <main class="@(User.Identity?.IsAuthenticated == true ? "content-with-sidebar" : "")">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>