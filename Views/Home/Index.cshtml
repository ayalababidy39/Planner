@{
    ViewData["Title"] = "Welcome";
    Layout = "_Layout";
    var isLoggedIn = User.Identity?.IsAuthenticated == true;
}

<!-- Tailwind + خط أنيق -->
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    body {
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
        background: #0B0F19;
    }
</style>

<div class="relative min-h-screen bg-[#0B0F19] text-slate-100 antialiased overflow-hidden selection:bg-indigo-500 selection:text-white">

    <!-- Ambient Glows -->
    <div class="pointer-events-none absolute inset-0 overflow-hidden -z-10">
        <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[900px] h-[550px] bg-gradient-to-b from-indigo-600/20 via-purple-600/10 to-transparent blur-3xl rounded-full"></div>
        <div class="absolute top-[650px] -left-36 w-96 h-96 bg-blue-600/10 blur-3xl rounded-full"></div>
        <div class="absolute top-[950px] -right-36 w-96 h-96 bg-purple-600/10 blur-3xl rounded-full"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24 space-y-28">

        <!-- 1. Hero Section -->
        <section class="text-center max-w-4xl mx-auto space-y-8 pt-4">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-indigo-500/30 bg-indigo-500/10 backdrop-blur-md text-indigo-300 text-xs sm:text-sm font-semibold tracking-wider uppercase shadow-inner shadow-indigo-500/20">
                <span class="inline-block w-2 h-2 rounded-full bg-indigo-400 animate-pulse"></span>
                Smart Study Planner
            </div>

            <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-[1.15]">
                Plan smarter. <span class="bg-gradient-to-r from-indigo-400 via-purple-300 to-pink-400 bg-clip-text text-transparent">Study better.</span><br />
                Achieve more. 🎯
            </h1>

            <p class="text-lg sm:text-xl text-slate-400 max-w-2xl mx-auto leading-relaxed">
                Your personal study companion — organize subjects, generate smart plans, track progress, and build powerful daily streaks.
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
                @if (isLoggedIn)
                {
                    <a asp-controller="Dashboard" asp-action="Index"
                       class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl font-semibold text-white bg-gradient-to-r from-indigo-600 via-indigo-500 to-purple-600 hover:from-indigo-500 hover:to-purple-500 shadow-lg shadow-indigo-500/25 transition-all duration-200 transform hover:-translate-y-0.5">
                        🚀 Go to Dashboard
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Register"
                       class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl font-semibold text-white bg-gradient-to-r from-indigo-600 via-indigo-500 to-purple-600 hover:from-indigo-500 hover:to-purple-500 shadow-lg shadow-indigo-500/25 transition-all duration-200 transform hover:-translate-y-0.5">
                        ✨ Get Started Free
                    </a>
                    <a asp-controller="Account" asp-action="Login"
                       class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl font-semibold text-slate-200 bg-slate-900/80 hover:bg-slate-800 border border-slate-800 hover:border-slate-700 backdrop-blur-md transition-all duration-200">
                        🔑 Login
                    </a>
                }
            </div>

            <!-- Quick Metrics -->
            <div class="pt-8 grid grid-cols-3 max-w-xl mx-auto gap-4 p-4 rounded-2xl border border-slate-800/80 bg-slate-900/40 backdrop-blur-sm">
                <div class="text-center">
                    <div class="text-2xl sm:text-3xl font-bold text-white">96%</div>
                    <div class="text-xs text-slate-400 mt-1">Exam Readiness</div>
                </div>
                <div class="text-center border-x border-slate-800/80">
                    <div class="text-2xl sm:text-3xl font-bold text-amber-400">🔥 24d</div>
                    <div class="text-xs text-slate-400 mt-1">Daily Streak</div>
                </div>
                <div class="text-center">
                    <div class="text-2xl sm:text-3xl font-bold text-indigo-400">+3.5 hrs</div>
                    <div class="text-xs text-slate-400 mt-1">Focused Time/Day</div>
                </div>
            </div>
        </section>

        <!-- 2. Features Section -->
        <section class="space-y-16">
            <div class="text-center max-w-3xl mx-auto space-y-4">
                <span class="text-xs sm:text-sm font-bold uppercase tracking-widest text-indigo-400">Everything You Need</span>
                <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
                    Features that keep you on track
                </h2>
                <p class="text-slate-400 text-base sm:text-lg">
                    All the tools you need to build a consistent study habit.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
                <!-- Subject Management -->
                <div class="group relative rounded-2xl border border-slate-800/80 bg-gradient-to-b from-slate-900/90 to-slate-950/90 p-8 hover:border-indigo-500/50 hover:shadow-xl hover:shadow-indigo-500/10 transition-all duration-300">
                    <div class="w-14 h-14 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-2xl mb-6 group-hover:scale-110 transition-transform">
                        📚
                    </div>
                    <h3 class="text-xl font-bold text-white mb-2">Subject Management</h3>
                    <p class="text-slate-400 text-sm leading-relaxed mb-6">
                        Add your subjects with difficulty level and exam date. The planner organizes everything for you.
                    </p>
                    <a asp-controller="Subjects" asp-action="Index"
                       class="inline-flex items-center text-sm font-semibold text-indigo-400 group-hover:text-indigo-300 group-hover:translate-x-1 transition-all">
                        Manage Subjects <span class="ml-1">→</span>
                    </a>
                </div>

                <!-- Smart Study Plans -->
                <div class="group relative rounded-2xl border border-slate-800/80 bg-gradient-to-b from-slate-900/90 to-slate-950/90 p-8 hover:border-purple-500/50 hover:shadow-xl hover:shadow-purple-500/10 transition-all duration-300">
                    <div class="w-14 h-14 rounded-xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-2xl mb-6 group-hover:scale-110 transition-transform">
                        🗓
                    </div>
                    <h3 class="text-xl font-bold text-white mb-2">Smart Study Plans</h3>
                    <p class="text-slate-400 text-sm leading-relaxed mb-6">
                        Generate a personalized daily plan based on your available time and subject difficulty.
                    </p>
                    <a asp-controller="StudyPlan" asp-action="Index"
                       class="inline-flex items-center text-sm font-semibold text-purple-400 group-hover:text-purple-300 group-hover:translate-x-1 transition-all">
                        View Plans <span class="ml-1">→</span>
                    </a>
                </div>

                <!-- Task Tracking -->
                <div class="group relative rounded-2xl border border-slate-800/80 bg-gradient-to-b from-slate-900/90 to-slate-950/90 p-8 hover:border-emerald-500/50 hover:shadow-xl hover:shadow-emerald-500/10 transition-all duration-300">
                    <div class="w-14 h-14 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-2xl mb-6 group-hover:scale-110 transition-transform">
                        ✅
                    </div>
                    <h3 class="text-xl font-bold text-white mb-2">Task Tracking</h3>
                    <p class="text-slate-400 text-sm leading-relaxed mb-6">
                        Complete tasks daily and watch your progress grow. Stay focused on what matters today.
                    </p>
                    <a asp-controller="Dashboard" asp-action="Index"
                       class="inline-flex items-center text-sm font-semibold text-emerald-400 group-hover:text-emerald-300 group-hover:translate-x-1 transition-all">
                        Today's Tasks <span class="ml-1">→</span>
                    </a>
                </div>

                <!-- Daily Streaks -->
                <div class="group relative rounded-2xl border border-slate-800/80 bg-gradient-to-b from-slate-900/90 to-slate-950/90 p-8 hover:border-amber-500/50 hover:shadow-xl hover:shadow-amber-500/10 transition-all duration-300">
                    <div class="w-14 h-14 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-2xl mb-6 group-hover:scale-110 transition-transform">
                        🔥
                    </div>
                    <h3 class="text-xl font-bold text-white mb-2">Daily Streaks</h3>
                    <p class="text-slate-400 text-sm leading-relaxed mb-6">
                        Build a powerful streak by studying every day. Track your current and longest streaks.
                    </p>
                    <a asp-controller="Dashboard" asp-action="Index"
                       class="inline-flex items-center text-sm font-semibold text-amber-400 group-hover:text-amber-300 group-hover:translate-x-1 transition-all">
                        Check Streak <span class="ml-1">→</span>
                    </a>
                </div>

                <!-- Points & Rewards -->
                <div class="group relative rounded-2xl border border-slate-800/80 bg-gradient-to-b from-slate-900/90 to-slate-950/90 p-8 hover:border-yellow-500/50 hover:shadow-xl hover:shadow-yellow-500/10 transition-all duration-300">
                    <div class="w-14 h-14 rounded-xl bg-yellow-500/10 border border-yellow-500/20 flex items-center justify-center text-2xl mb-6 group-hover:scale-110 transition-transform">
                        ⭐
                    </div>
                    <h3 class="text-xl font-bold text-white mb-2">Points & Rewards</h3>
                    <p class="text-slate-400 text-sm leading-relaxed mb-6">
                        Earn points for every completed task. Stay motivated with a gamified study experience.
                    </p>
                    <a asp-controller="Dashboard" asp-action="Index"
                       class="inline-flex items-center text-sm font-semibold text-yellow-400 group-hover:text-yellow-300 group-hover:translate-x-1 transition-all">
                        See Points <span class="ml-1">→</span>
                    </a>
                </div>

                <!-- Progress Dashboard -->
                <div class="group relative rounded-2xl border border-slate-800/80 bg-gradient-to-b from-slate-900/90 to-slate-950/90 p-8 hover:border-blue-500/50 hover:shadow-xl hover:shadow-blue-500/10 transition-all duration-300">
                    <div class="w-14 h-14 rounded-xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-2xl mb-6 group-hover:scale-110 transition-transform">
                        📊
                    </div>
                    <h3 class="text-xl font-bold text-white mb-2">Progress Dashboard</h3>
                    <p class="text-slate-400 text-sm leading-relaxed mb-6">
                        See your overall completion rate, most delayed subjects, and upcoming exams at a glance.
                    </p>
                    <a asp-controller="Dashboard" asp-action="Index"
                       class="inline-flex items-center text-sm font-semibold text-blue-400 group-hover:text-blue-300 group-hover:translate-x-1 transition-all">
                        View Dashboard <span class="ml-1">→</span>
                    </a>
                </div>
            </div>
        </section>

        <!-- 3. How It Works Section -->
        <section class="space-y-16">
            <div class="text-center max-w-3xl mx-auto space-y-4">
                <span class="text-xs sm:text-sm font-bold uppercase tracking-widest text-indigo-400">Simple & Effective</span>
                <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">How it works</h2>
                <p class="text-slate-400 text-base sm:text-lg">Three simple steps to a smarter study routine.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
                <div class="relative rounded-2xl border border-slate-800/70 bg-slate-900/50 p-8 text-center space-y-4 hover:border-slate-700 transition-colors">
                    <div class="w-12 h-12 rounded-full bg-gradient-to-br from-indigo-500 to-indigo-700 text-white font-extrabold text-lg flex items-center justify-center mx-auto shadow-lg shadow-indigo-500/30">
                        1
                    </div>
                    <h3 class="text-xl font-bold text-white">Add your subjects</h3>
                    <p class="text-slate-400 text-sm leading-relaxed">Enter subject name, exam date, and difficulty level.</p>
                </div>

                <div class="relative rounded-2xl border border-slate-800/70 bg-slate-900/50 p-8 text-center space-y-4 hover:border-slate-700 transition-colors">
                    <div class="w-12 h-12 rounded-full bg-gradient-to-br from-purple-500 to-purple-700 text-white font-extrabold text-lg flex items-center justify-center mx-auto shadow-lg shadow-purple-500/30">
                        2
                    </div>
                    <h3 class="text-xl font-bold text-white">Generate a plan</h3>
                    <p class="text-slate-400 text-sm leading-relaxed">Choose daily study time and let the planner do the work.</p>
                </div>

                <div class="relative rounded-2xl border border-slate-800/70 bg-slate-900/50 p-8 text-center space-y-4 hover:border-slate-700 transition-colors">
                    <div class="w-12 h-12 rounded-full bg-gradient-to-br from-pink-500 to-pink-700 text-white font-extrabold text-lg flex items-center justify-center mx-auto shadow-lg shadow-pink-500/30">
                        3
                    </div>
                    <h3 class="text-xl font-bold text-white">Study & track</h3>
                    <p class="text-slate-400 text-sm leading-relaxed">Complete tasks daily, earn points, and grow your streak.</p>
                </div>
            </div>
        </section>

        <!-- 4. CTA Section for Guests -->
        @if (!isLoggedIn)
        {
            <section class="relative rounded-3xl overflow-hidden border border-indigo-500/30 bg-gradient-to-r from-indigo-950 via-slate-900 to-purple-950 p-10 sm:p-16 text-center space-y-6 shadow-2xl">
                <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-indigo-500/20 via-transparent to-transparent pointer-events-none"></div>

                <div class="relative z-10 max-w-2xl mx-auto space-y-4">
                    <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">Ready to start?</h2>
                    <p class="text-slate-300 text-base sm:text-lg">Create your free account and build a smarter study routine today.</p>

                    <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
                        <a asp-controller="Account" asp-action="Register"
                           class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-xl font-semibold text-white bg-indigo-600 hover:bg-indigo-500 shadow-xl shadow-indigo-600/30 transition-all">
                            Create Free Account
                        </a>
                        <a asp-controller="Account" asp-action="Login"
                           class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-xl font-semibold text-slate-300 hover:text-white bg-slate-800/80 hover:bg-slate-800 border border-slate-700 transition-all">
                            I already have one
                        </a>
                    </div>
                </div>
            </section>
        }

    </div>
</div>