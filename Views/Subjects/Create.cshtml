@model Planner.Models.Subject
@{
    ViewData["Title"] = "Add Subject";
}
<div class="container page narrow">
    <div class="page-title"><div><span class="eyebrow">NEW SUBJECT</span><h1>Add a subject</h1><p>Give the planner the information it needs.</p></div></div>
    <div class="panel">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control form-control-lg" placeholder="e.g. C# Programming" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Difficulty" class="form-label">Difficulty (1–5)</label>
                <input asp-for="Difficulty" class="form-control" min="1" max="5" />
            </div>
            <div class="mb-3">
                <label asp-for="ExamDate" class="form-label"></label>
                <input asp-for="ExamDate" type="date" class="form-control" />
            </div>
            <div class="mb-4">
                <label asp-for="TotalDays" class="form-label">Available study days</label>
                <input asp-for="TotalDays" class="form-control" min="1" />
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-primary">Save Subject</button>
                <a asp-action="Index" class="btn btn-light">Cancel</a>
            </div>
        </form>
    </div>
</div>