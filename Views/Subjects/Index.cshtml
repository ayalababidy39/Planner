@model IEnumerable<Planner.Models.Subject>
@{
    ViewData["Title"] = "Subjects";
}

<!-- Tailwind + الخط -->
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<!-- اجعل التنسيق محصورًا داخل هذه الصفحة فقط -->
<style>
    .subjects-page,
    .subjects-page * {
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
        box-sizing: border-box;
    }

    .subjects-page {
        background-color: #0B0F19;
        color: #e2e8f0;
        border-radius: 16px;
        min-height: calc(100vh - 120px);
        position: relative;
    }

        .subjects-page .line-clamp-1 {
            display: -webkit-box;
            -webkit-line-clamp: 1;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        /* تعطيل تأثير Bootstrap على الأزرار داخل هذه الصفحة */
        .subjects-page button,
        .subjects-page a {
            text-decoration: none;
        }
</style>

<div class="subjects-page antialiased selection:bg-indigo-500 selection:text-white">

    <!-- خلفيات ضوئية ناعمة -->
    <div class="pointer-events-none absolute inset-0 overflow-hidden rounded-2xl -z-10">
        <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[850px] h-[500px] bg-gradient-to-b from-indigo-600/15 via-purple-600/10 to-transparent blur-3xl rounded-full"></div>
        <div class="absolute top-[500px] -right-32 w-80 h-80 bg-purple-600/10 blur-3xl rounded-full"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-14 space-y-10 relative">

        <!-- العنوان + زر الإضافة -->
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 pb-6 border-b border-slate-800/80">
            <div class="space-y-2">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase text-indigo-400 bg-indigo-500/10 border border-indigo-500/20">
                    <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span>
                    Your Courses
                </span>
                <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight m-0">Subjects</h1>
                <p class="text-slate-400 text-sm sm:text-base max-w-xl m-0">
                    Manage the subjects you want the planner to organize, balance study hours, and prepare for exams.
                </p>
            </div>

            <div>
                <a asp-action="Create" class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl font-semibold text-white bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-500 hover:to-purple-500 shadow-lg shadow-indigo-500/25 transition-all duration-200 transform hover:-translate-y-0.5 whitespace-nowrap no-underline">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
                    </svg>
                    Add Subject
                </a>
            </div>
        </div>

        @if (!Model.Any())
        {
            <!-- حالة خلو القائمة -->
            <div class="text-center py-20 px-6 rounded-3xl border border-dashed border-slate-800 bg-slate-900/30">
                <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-3xl">
                    📚
                </div>
                <h3 class="text-xl font-bold text-white mb-2">No subjects added yet</h3>
                <p class="text-slate-400 text-sm max-w-md mx-auto mb-6">
                    Start by adding your current courses or exam subjects to unlock personalized study schedules.
                </p>
                <a asp-action="Create" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-500 transition-colors shadow-lg shadow-indigo-500/20 no-underline">
                    + Add Your First Subject
                </a>
            </div>
        }
        else
        {
            <!-- شبكة البطاقات -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var s in Model)
                {
                    var days = Math.Max(0, (s.ExamDate.Date - DateTime.Today).Days);

                    string badgeColor = days <= 7
                    ? "bg-rose-500/10 border-rose-500/20 text-rose-400"
                    : (days <= 14 ? "bg-amber-500/10 border-amber-500/20 text-amber-400" : "bg-emerald-500/10 border-emerald-500/20 text-emerald-400");

                    string dotColor = days <= 7
                    ? "bg-rose-400"
                    : (days <= 14 ? "bg-amber-400" : "bg-emerald-400");

                    <div class="group relative rounded-2xl border border-slate-800/80 bg-gradient-to-b from-slate-900/90 to-slate-950/90 p-6 flex flex-col justify-between hover:border-indigo-500/40 hover:shadow-xl hover:shadow-indigo-500/10 transition-all duration-300">
                        <div class="space-y-4">
                            <!-- الأيقونة والشارة -->
                            <div class="flex items-center justify-between">
                                <div class="w-12 h-12 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-xl shadow-inner group-hover:scale-105 transition-transform">
                                    📘
                                </div>
                                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold border @badgeColor shadow-sm">
                                    <span class="w-1.5 h-1.5 rounded-full @dotColor"></span>
                                    @days @(days == 1 ? "day left" : "days left")
                                </span>
                            </div>

                            <!-- الاسم والصعوبة -->
                            <div>
                                <h3 class="text-xl font-bold text-white group-hover:text-indigo-300 transition-colors line-clamp-1 m-0">
                                    @s.Name
                                </h3>

                                <div class="flex items-center gap-2 mt-2 flex-wrap">
                                    <div class="text-amber-400 text-sm tracking-widest font-mono">
                                        @(new string('★', s.Difficulty))@(new string('☆', 5 - s.Difficulty))
                                    </div>
                                    <span class="text-xs font-semibold px-2 py-0.5 rounded bg-slate-800 text-slate-300 border border-slate-700/60">
                                        Level @s.Difficulty/5
                                    </span>
                                </div>
                            </div>

                            <!-- تاريخ الاختبار -->
                            <div class="flex items-center gap-2 text-sm text-slate-400 bg-slate-950/50 p-3 rounded-xl border border-slate-800/60">
                                <svg class="w-4 h-4 text-indigo-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                                <span>Exam: <strong class="text-white font-medium">@s.ExamDate.ToString("dd MMM yyyy")</strong></span>
                            </div>
                        </div>

                        <!-- الأزرار -->
                        <div class="pt-6 mt-6 border-t border-slate-800/60 flex items-center gap-3">
                            <a asp-action="Edit" asp-route-id="@s.SubjectId"
                               class="flex-1 inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-xl text-sm font-semibold text-slate-200 bg-slate-800/90 hover:bg-slate-700 hover:text-white border border-slate-700/80 transition-all no-underline">
                                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                                </svg>
                                Edit
                            </a>

                            <form asp-action="Delete" asp-route-id="@s.SubjectId" method="post"
                                  onsubmit="return confirm('Are you sure you want to delete this subject?');"
                                  class="inline m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="inline-flex items-center justify-center px-4 py-2.5 rounded-xl text-sm font-semibold text-rose-400 hover:text-white hover:bg-rose-600/90 border border-rose-500/30 hover:border-rose-600 transition-all bg-transparent cursor-pointer">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }

    </div>
</div>