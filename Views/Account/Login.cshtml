@model Planner.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
}
<div class="auth-page">
    <div class="auth-card">
        <div class="logo-big">✓</div>
        <h1>Welcome back</h1>
        <p class="muted">Continue your study journey.</p>

        <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <label asp-for="Email"></label>
            <input asp-for="Email" class="form-control form-control-lg mb-3" placeholder="you@example.com" />

            <label asp-for="Password"></label>
            <input asp-for="Password" class="form-control form-control-lg mb-3" placeholder="••••••••" />

            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label">Remember me</label>
            </div>

            <button class="btn btn-primary btn-lg w-100">Login</button>
        </form>

        <p class="text-center mt-4 mb-0">New here? <a asp-action="Register">Create an account</a></p>
    </div>
</div>