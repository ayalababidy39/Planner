@model Planner.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
}
<div class="auth-page">
    <div class="auth-card">
        <div class="logo-big">✓</div>
        <h1>Create your account</h1>
        <p class="muted">Build a smarter study routine.</p>

        <form asp-action="Register" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <label asp-for="Name"></label>
            <input asp-for="Name" class="form-control form-control-lg mb-3" />

            <label asp-for="Email"></label>
            <input asp-for="Email" class="form-control form-control-lg mb-3" />

            <label asp-for="Password"></label>
            <input asp-for="Password" class="form-control form-control-lg mb-3" />

            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" class="form-control form-control-lg mb-3" />

            <button class="btn btn-primary btn-lg w-100">Create Account</button>
        </form>

        <p class="text-center mt-4 mb-0">Already have an account? <a asp-action="Login">Login</a></p>
    </div>
</div>